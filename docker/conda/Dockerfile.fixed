# ============================================================================
# SYMFLUENCE conda install (Method F from installation.html — Windows path,
# also documented as macOS Apple Silicon GDAL workaround)
#
#   conda create -n symfluence python=3.11
#   conda activate symfluence
#   conda install -c conda-forge gdal geopandas rasterio netcdf4 hdf5
#   pip install symfluence
#
# Build: docker build -f docker/conda/Dockerfile.fixed -t symfluence:conda-fixed .
# Run:   docker run --rm symfluence:conda-fixed --help
#
# Differences from Dockerfile (single-source conda-forge for the entire
# scientific toolchain — apt only carries host utilities):
#
#   + conda: extended beyond Method F's documented `gdal geopandas rasterio
#     netcdf4 hdf5` to every scientific library the model builds link
#     against (proj, geos, udunits2, netcdf-fortran, openmpi, openblas, plus
#     `boost` and `expat` which the registry doesn't cover — boost: ngen's
#     Boost ≥ 1.79 dep; expat: ngen's cmake adds -lexpat for Boost
#     PropertyTree XML parsing). Single, internally consistent toolchain so
#     the linker only ever sees one of each (libcurl, libnetcdf, libhdf5,
#     libudunits2, ...).
#
#   + CFLAGS/CPPFLAGS/LDFLAGS/PKG_CONFIG_PATH/CMAKE_PREFIX_PATH point at the
#     conda env, so makefiles + cmake projects find conda's headers and
#     libs first; -Wl,-rpath bakes the conda lib path into the produced
#     executables so they keep resolving to conda's libs at runtime.
#
#   + /lib64/libc.so.6 symlink — orthogonal aarch64 quirk in symfluence's
#     _build.sh GLIBC-detection probe (only checks x86_64 paths).
#
# Hacks dropped (no longer needed):
#   - apt build-essential/gfortran + OMPI_CC=/usr/bin/gcc overrides — the
#     registry's `gcc`/`gfortran` dep_ids now use conda-forge's
#     `c-compiler`/`cxx-compiler`/`fortran-compiler` metapackages, which
#     install unprefixed `gcc`/`g++`/`gfortran` shims on PATH that wrap
#     the prefix-named conda compilers that conda-forge openmpi was
#     actually built against. Single toolchain, no apt fallback needed.
#   - libhdf5_serial → libhdf5 symlinks — conda ships libhdf5.so directly.
#   - hide /usr/include/boost between pip install and binary install — no
#     system boost present without apt scientific dev libs.
# ============================================================================

FROM condaforge/miniforge3:24.11.3-2

# Host utilities only — everything else lives in the conda env created below.
# (compilers, make, pkg-config, cmake are all conda-installed now via the
# c-compiler/cxx-compiler/fortran-compiler metapackages.)
RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        curl \
        wget \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Workaround for upstream `symfluence binary install` GLIBC-mismatch probe:
# its `_build.sh` host-libc lookup only checks x86_64 paths; on aarch64 the
# real libc lives at /lib/aarch64-linux-gnu/libc.so.6. `uname -m` works on
# both arches without needing gcc (which isn't on PATH at this stage —
# it'll be installed by the conda step below).
RUN mkdir -p /lib64 \
    && ln -sf "/lib/$(uname -m)-linux-gnu/libc.so.6" /lib64/libc.so.6

# Single-source conda-forge env. The conda packages here map 1:1 to the
# canonical registry at src/symfluence/resources/system_deps.yml (all
# `required: true` deps plus default-toolset optionals udunits2, cdo,
# r_base, perl), plus geopandas/rasterio (Python deps with native bindings
# that need the same conda env's GDAL) and `boost`/`expat` which the model
# builds need but the registry doesn't cover (boost: ngen's Boost ≥1.79
# requirement; expat: ngen's cmake adds -lexpat for Boost PropertyTree).
RUN conda create -y -n symfluence python=3.11 \
    && conda install -y -n symfluence -c conda-forge \
         c-compiler cxx-compiler fortran-compiler make cmake \
         gdal geopandas rasterio netcdf4 netcdf-fortran hdf5 \
         proj geos udunits2 cdo \
         openmpi openblas boost expat \
         r-base perl \
    && conda clean -afy

# `conda activate` doesn't work in a `RUN` (the shell isn't interactive);
# put the env's bin on PATH and set CONDA_DEFAULT_ENV instead. The conda
# c-compiler metapackage installs unprefixed `gcc`/`g++`/`gfortran` shims
# in the env's bin/, which wrap the prefix-named compilers that
# conda-forge openmpi was built against — so mpicc's wrapper-compiler
# lookup succeeds without needing OMPI_CC overrides.
#
# OMPI env vars: compiled hydrology models invoke OpenMPI; default refuses root.
# CFLAGS/LDFLAGS/PKG_CONFIG_PATH/CMAKE_PREFIX_PATH: point compilers + cmake
# at the conda env so model builds find conda's headers/libs first; rpath
# bakes the conda lib path into produced executables.
ENV PATH=/opt/conda/envs/symfluence/bin:$PATH \
    CONDA_DEFAULT_ENV=symfluence \
    CONDA_PREFIX=/opt/conda/envs/symfluence \
    HDF5_USE_FILE_LOCKING=FALSE \
    OMPI_ALLOW_RUN_AS_ROOT=1 \
    OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1 \
    PYTHONUNBUFFERED=1 \
    CFLAGS="-I/opt/conda/envs/symfluence/include" \
    CPPFLAGS="-I/opt/conda/envs/symfluence/include" \
    LDFLAGS="-L/opt/conda/envs/symfluence/lib -Wl,-rpath,/opt/conda/envs/symfluence/lib" \
    PKG_CONFIG_PATH=/opt/conda/envs/symfluence/lib/pkgconfig \
    CMAKE_PREFIX_PATH=/opt/conda/envs/symfluence

RUN pip install --no-cache-dir symfluence

# Pin the install location so `symfluence binary install` does not infer it
# from WORKDIR via the auto-resolver (which would place it at e.g.
# /opt/SYMFLUENCE_data). Aligns build-time install path with docker-compose's
# named-volume mount at /SYMFLUENCE_data/installs and with the cwd-relative
# `../SYMFLUENCE_data` paths the example configs resolve from /workspace.
ENV SYMFLUENCE_DATA_DIR=/SYMFLUENCE_data

RUN symfluence binary install

WORKDIR /workspace

ENTRYPOINT ["symfluence"]
CMD ["--help"]
