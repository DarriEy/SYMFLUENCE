# ============================================================================
# SYMFLUENCE conda install (Method F from installation.html — Windows path,
# also documented as macOS Apple Silicon GDAL workaround)
#
#   conda create -n symfluence python=3.11
#   conda activate symfluence
#   conda install -c conda-forge gdal geopandas rasterio netcdf4 hdf5
#   pip install symfluence
#
# Base image matches the existing root Dockerfile.
#
# Build: docker build -f docker/conda/Dockerfile.fixed -t symfluence:conda-fixed .
# Run:   docker run --rm symfluence:conda-fixed --help
#
# Differences from Dockerfile:
#   + apt build toolchain        (miniforge3 base lacks gcc/gfortran/cmake;
#                                 several pip wheels — fiona, psutil,
#                                 exactextract, copulae — need to compile from
#                                 source on linux/aarch64)
#   + libproj-dev libgeos-dev    (README.md L125; fixes taudem/gistool PROJ)
#   + libudunits2-dev            (surfaced by `symfluence binary doctor`)
#   + pkg-config + wget          (cmake's BLAS probe + ngen Boost 1.79 fetch)
#   + libhdf5_serial → libhdf5   (fuse Makefile passes -L/usr/lib -lhdf5)
#   + /lib64/libc.so.6 symlink   (works around `_build.sh` GLIBC-detection bug)
#   + hide /usr/include/boost    (system Boost 1.74 conflicts with ngen's
#                                 required ≥1.79; rename headers between pip
#                                 install and binary install)
# ============================================================================

FROM condaforge/miniforge3:24.11.3-2

# miniforge3 is Debian-based but has no compilers — install build toolchain +
# dev libs so pip wheels can compile and `symfluence binary install` can run.
# Same set as docker/pip/Dockerfile.fixed (Debian package names).
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        gfortran \
        cmake \
        pkg-config \
        libopenmpi-dev \
        openmpi-bin \
        libopenblas-dev \
        liblapack-dev \
        libnetcdf-dev \
        libnetcdff-dev \
        libhdf5-dev \
        gdal-bin \
        libgdal-dev \
        libproj-dev \
        libgeos-dev \
        libudunits2-dev \
        git \
        curl \
        wget \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Debian's libhdf5-dev installs as libhdf5_serial.so under /usr/lib/<arch>/.
# fuse's Makefile passes `-L/usr/lib -lhdf5 -lhdf5_hl`, so symlink there.
RUN ARCH=$(gcc -print-multiarch) \
    && ARCH_LIB=/usr/lib/${ARCH} \
    && for src in libhdf5_serial.so libhdf5_serial_hl.so libhdf5_serial_fortran.so libhdf5_serialhl_fortran.so; do \
         test -f "${ARCH_LIB}/${src}" || { echo "MISSING source: ${ARCH_LIB}/${src}"; exit 1; }; \
       done \
    && ln -sf "${ARCH_LIB}/libhdf5_serial.so"           /usr/lib/libhdf5.so \
    && ln -sf "${ARCH_LIB}/libhdf5_serial_hl.so"        /usr/lib/libhdf5_hl.so \
    && ln -sf "${ARCH_LIB}/libhdf5_serial_fortran.so"   /usr/lib/libhdf5_fortran.so \
    && ln -sf "${ARCH_LIB}/libhdf5_serialhl_fortran.so" /usr/lib/libhdf5_hl_fortran.so

# Workaround for upstream `symfluence binary install` GLIBC-mismatch probe:
# its `_build.sh` host-libc lookup only checks x86_64 paths; on aarch64 the
# real libc lives at /lib/aarch64-linux-gnu/libc.so.6. Putting libc.so.6 at
# /lib64/ makes the probe succeed on any arch.
RUN mkdir -p /lib64 \
    && ln -sf "/lib/$(gcc -print-multiarch)/libc.so.6" /lib64/libc.so.6

# Verbatim conda command sequence from installation.html "Windows" subsection.
RUN conda create -y -n symfluence python=3.11 \
    && conda install -y -n symfluence -c conda-forge \
         gdal geopandas rasterio netcdf4 hdf5 \
    && conda clean -afy

# `conda activate` doesn't work in a `RUN` (the shell isn't interactive);
# put the env's bin on PATH and set CONDA_DEFAULT_ENV instead.
# OMPI env vars: compiled hydrology models invoke OpenMPI; default refuses root.
ENV PATH=/opt/conda/envs/symfluence/bin:$PATH \
    CONDA_DEFAULT_ENV=symfluence \
    CONDA_PREFIX=/opt/conda/envs/symfluence \
    HDF5_USE_FILE_LOCKING=FALSE \
    OMPI_ALLOW_RUN_AS_ROOT=1 \
    OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1 \
    PYTHONUNBUFFERED=1

RUN pip install --no-cache-dir symfluence

# libboost-dev (1.74) is pulled in transitively (by libgdal-dev) and is needed
# by some pip wheels at build time. After install, hide its headers so
# ngen's cmake `find_package(Boost ≥ 1.79)` doesn't pick them up — it'll then
# fall back to the Boost 1.79 its `_build.sh` downloads via wget.
RUN [ -d /usr/include/boost ] && mv /usr/include/boost /usr/include/boost.disabled || true

RUN symfluence binary install

WORKDIR /workspace

ENTRYPOINT ["symfluence"]
CMD ["--help"]
