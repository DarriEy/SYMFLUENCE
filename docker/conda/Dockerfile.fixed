# ============================================================================
# SYMFLUENCE conda install (Method F from installation.html — Windows path,
# also documented as macOS Apple Silicon GDAL workaround)
#
#   conda create -n symfluence python=3.11
#   conda activate symfluence
#   conda install -c conda-forge gdal geopandas rasterio netcdf4 hdf5
#   pip install symfluence
#
# Build: docker build -f docker/conda/Dockerfile.fixed -t symfluence:conda-fixed .
# Run:   docker run --rm symfluence:conda-fixed --help
#
# Differences from Dockerfile (single-source conda-forge for the native
# scientific stack — the prior Dockerfile.fixed mixed apt-installed dev libs
# with conda-installed libs, and the link stage picked conda's libcurl /
# libnetcdf while system libhdf5_serial.so wanted CURL_OPENSSL_4-versioned
# symbols, killing fuse/mizuroute/ngen/summa with undefined references):
#
#   + apt: only what conda-forge can't (or shouldn't) provide:
#       build-essential, gfortran, make, pkg-config — model Makefiles
#         (e.g. fuse) hardcode unprefixed gcc/g++/gfortran/make; conda-forge
#         compilers are prefix-named and would need symlink wrappers
#       git, curl, wget, ca-certificates           — model source clones,
#         ngen's boost-1.79 fetch fallback (boost is also on conda below)
#
#   + conda: every scientific library the build links against:
#       hdf5, netcdf-fortran, gdal, proj, geos, udunits2, openmpi,
#       openblas, boost, expat, cmake               — single, internally
#                                                     consistent toolchain.
#       (libnetcdf-C is pulled in transitively by netcdf4/netcdf-fortran;
#        no separate `netcdf-c` package on conda-forge linux-aarch64.
#        `expat` is needed because ngen's cmake adds `-lexpat` to its
#        link line — Boost.PropertyTree pulls it in for XML parsing.)
#
#   + CFLAGS/CPPFLAGS/LDFLAGS/PKG_CONFIG_PATH/CMAKE_PREFIX_PATH point at the
#     conda env, so makefiles + cmake projects find conda's headers and
#     libs first; -Wl,-rpath bakes the conda lib path into the produced
#     executables so they keep resolving to conda's libs at runtime.
#
#   + /lib64/libc.so.6 symlink retained — orthogonal aarch64 quirk in
#     symfluence's _build.sh GLIBC-detection probe (only checks x86_64 paths).
#
# Hacks dropped (no longer needed under single-source toolchain):
#   - libhdf5_serial → libhdf5 symlinks   (conda ships libhdf5.so directly)
#   - hide /usr/include/boost between pip install and binary install
#                                          (no system boost is pulled in
#                                           without apt scientific dev libs;
#                                           ngen finds conda's boost via
#                                           CMAKE_PREFIX_PATH)
# ============================================================================

FROM condaforge/miniforge3:24.11.3-2

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        gfortran \
        make \
        pkg-config \
        git \
        curl \
        wget \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Workaround for upstream `symfluence binary install` GLIBC-mismatch probe:
# its `_build.sh` host-libc lookup only checks x86_64 paths; on aarch64 the
# real libc lives at /lib/aarch64-linux-gnu/libc.so.6.
RUN mkdir -p /lib64 \
    && ln -sf "/lib/$(gcc -print-multiarch)/libc.so.6" /lib64/libc.so.6

# Single-source conda-forge env. Method F's documented `gdal geopandas
# rasterio netcdf4 hdf5` is extended to include every C/Fortran library the
# downstream model builds link against, so the linker only ever sees one of
# each (libcurl, libnetcdf, libhdf5, libudunits2, ...).
RUN conda create -y -n symfluence python=3.11 \
    && conda install -y -n symfluence -c conda-forge \
         gdal geopandas rasterio netcdf4 \
         hdf5 netcdf-fortran proj geos udunits2 \
         openmpi openblas boost expat \
         cmake \
    && conda clean -afy

# `conda activate` doesn't work in a `RUN` (the shell isn't interactive);
# put the env's bin on PATH and set CONDA_DEFAULT_ENV instead.
# OMPI env vars: compiled hydrology models invoke OpenMPI; default refuses root.
# OMPI_CC/CXX/FC point conda's mpicc wrappers at system gcc/g++/gfortran —
# conda-forge openmpi was built against `aarch64-conda-linux-gnu-cc` (the
# conda-forge `gcc_linux-aarch64` compiler), which we deliberately don't
# install (model Makefiles hardcode unprefixed gcc). Without this override,
# `mpicc` errors with "wrapper compiler unable to find aarch64-conda-linux-
# gnu-cc in PATH" and TauDEM's cmake C-compiler probe fails.
# CFLAGS/LDFLAGS/PKG_CONFIG_PATH/CMAKE_PREFIX_PATH: point compilers + cmake
# at the conda env so model builds find conda's headers/libs first; rpath
# bakes the conda lib path into produced executables.
ENV PATH=/opt/conda/envs/symfluence/bin:$PATH \
    CONDA_DEFAULT_ENV=symfluence \
    CONDA_PREFIX=/opt/conda/envs/symfluence \
    HDF5_USE_FILE_LOCKING=FALSE \
    OMPI_ALLOW_RUN_AS_ROOT=1 \
    OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1 \
    OMPI_CC=/usr/bin/gcc \
    OMPI_CXX=/usr/bin/g++ \
    OMPI_FC=/usr/bin/gfortran \
    PYTHONUNBUFFERED=1 \
    CFLAGS="-I/opt/conda/envs/symfluence/include" \
    CPPFLAGS="-I/opt/conda/envs/symfluence/include" \
    LDFLAGS="-L/opt/conda/envs/symfluence/lib -Wl,-rpath,/opt/conda/envs/symfluence/lib" \
    PKG_CONFIG_PATH=/opt/conda/envs/symfluence/lib/pkgconfig \
    CMAKE_PREFIX_PATH=/opt/conda/envs/symfluence

RUN pip install --no-cache-dir symfluence

RUN symfluence binary install

WORKDIR /workspace

ENTRYPOINT ["symfluence"]
CMD ["--help"]
